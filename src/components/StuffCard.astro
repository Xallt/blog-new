---
import type { Stuff } from "../data/home";
import BlurImage from "./BlurImage.astro";

interface Props {
	stuff: Stuff;
}

const { stuff } = Astro.props;
---

<div class="stuff-card">
	{
		stuff.image && (
			<BlurImage
				src={stuff.image}
				alt={stuff.name}
				wrapClass="stuff-card-media"
				class="stuff-card-img"
			/>
		)
	}
	<div class="stuff-card-title-row">
		<h3 class="stuff-card-title">
			<a class="stuff-card-link" href={stuff.href}>{stuff.name}</a>
		</h3>
		{stuff.githubUrl && (
			<a
				class="stuff-card-github"
				href={stuff.githubUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`${stuff.name} on GitHub`}
			>
				<i class="fab fa-github"></i>
			</a>
		)}
	</div>
	<p class="stuff-card-desc">{stuff.description}</p>
</div>

<style>
	.stuff-card {
		border: 1px solid var(--border-color);
		border-radius: 4px;
		overflow: hidden;
		background: var(--surface-color);
		position: relative;
		min-height: 8rem;
		display: flex;
		flex-direction: column;
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.stuff-card:hover {
		border-color: var(--text-muted-color);
	}

	.stuff-card :global(.stuff-card-media) {
		width: 100%;
		height: 8rem;
		border-radius: 0;
	}

	.stuff-card :global(.stuff-card-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.stuff-card-title-row {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		padding: var(--space-sm) var(--space-sm) var(--space-xs);
	}

	.stuff-card-title {
		flex: 1;
		margin: 0;
		font-size: 1.3rem;
		font-weight: 400;
		line-height: 1.2;
	}

	.stuff-card-link {
		text-decoration: none;
		color: inherit;
	}

	.stuff-card-link::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.stuff-card-link:focus-visible::after {
		outline: 2px solid var(--text-color);
		outline-offset: 2px;
	}

	.stuff-card-github {
		position: relative;
		z-index: 1;
		flex-shrink: 0;
		color: var(--text-muted-color);
		font-size: 1.3rem;
		line-height: 1;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.stuff-card-github:hover {
		color: var(--text-color);
	}

	.stuff-card-desc {
		margin: 0;
		padding: 0 var(--space-sm) var(--space-sm);
		font-family: var(--font-family-base);
		font-size: 1rem;
		line-height: 1.4;
		color: var(--text-muted-color);
	}
</style>
