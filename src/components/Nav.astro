---
import type { NavItem } from "../data/home";

interface Props {
	items: NavItem[];
}

const { items } = Astro.props;

function normalizePath(p: string): string {
	if (p.length > 1 && p.endsWith("/")) {
		return p.slice(0, -1);
	}
	return p;
}

const baseRoot = normalizePath(import.meta.env.BASE_URL);

function isNavActive(href: string, pathname: string): boolean {
	const path = normalizePath(pathname);
	const target = normalizePath(href);
	// Root of the app (/ or base URL like /blog-new) — exact match only
	if (target === "/" || target === "" || target === baseRoot) {
		return path === target;
	}
	return path === target || path.startsWith(`${target}/`);
}

const pathname = Astro.url.pathname;
---

<nav class="nav" aria-label="Primary">
	{
		items.map((item) => {
			const active = isNavActive(item.href, pathname);
			return (
				<a
					class:list={["bracketed", { "nav-link-active": active }]}
					href={item.href}
					aria-current={active ? "page" : undefined}
				>
					{item.label}
				</a>
			);
		})
	}
	<button
		type="button"
		id="theme-toggle"
		class="theme-toggle"
		aria-label="Toggle dark and light theme"
		title="Toggle theme"
	>
		<i class="fa-solid fa-moon theme-icon theme-icon-dark" aria-hidden="true"></i>
		<i class="fa-solid fa-sun theme-icon theme-icon-light" aria-hidden="true"></i>
	</button>
</nav>

<script is:inline>
	(() => {
		const btn = document.getElementById("theme-toggle");
		if (!btn) return;
		btn.addEventListener("click", () => {
			const root = document.documentElement;
			const next = root.dataset.theme === "light" ? "dark" : "light";
			root.dataset.theme = next;
			try {
				localStorage.setItem("theme", next);
			} catch (_) {}
		});
	})();
</script>

<style>
	.nav {
		font-family: var(--font-family-base);
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-sm) var(--space-md);
		margin-bottom: var(--space-sm);
	}

	.nav a {
		text-decoration: none;
	}

	.nav a:hover {
		text-decoration: underline;
	}

	.nav a.nav-link-active {
		color: color-mix(in srgb, var(--link-color) 80%, rgb(255 255 255) 20%);
		font-weight: 600;
		text-decoration: none;
	}

	.bracketed.nav-link-active::before,
	.bracketed.nav-link-active::after {
		opacity: 1;
	}

	.bracketed::before {
		content: "<";
		opacity: 0.85;
	}

	.bracketed::after {
		content: ">";
		opacity: 0.85;
	}

	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.9rem;
		height: 1.9rem;
		padding: 0;
		margin-block: -0.3rem;
		border: 1px solid var(--border-color);
		border-radius: 50%;
		background: transparent;
		color: var(--text-muted-color);
		cursor: pointer;
		line-height: 1;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background 0.15s ease,
			transform 0.15s ease;
	}

	.theme-toggle:hover {
		color: var(--link-color);
		border-color: var(--link-color);
		background: color-mix(in srgb, var(--link-color) 12%, transparent);
		transform: rotate(-12deg);
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--link-color);
		outline-offset: 2px;
	}

	.theme-icon {
		font-size: 0.85rem;
	}

	/* Show the icon for the theme you can switch *to*. */
	.theme-icon-light {
		display: none;
	}

	:global(:root[data-theme="light"]) .theme-icon-dark {
		display: none;
	}

	:global(:root[data-theme="light"]) .theme-icon-light {
		display: inline;
	}
</style>
