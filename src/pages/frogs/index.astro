---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { readFile } from "node:fs/promises";
import path from "node:path";
import sharp from "sharp";
import Nav from "../../components/Nav.astro";
import { familyImage, frogs } from "../../data/frogs";
import { navItems } from "../../data/home";
import BaseLayout from "../../layouts/BaseLayout.astro";

const frogImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/img/frogs/*.{jpeg,jpg,png}",
);

async function loadFrog(file: string): Promise<ImageMetadata> {
  const key = `/src/assets/img/frogs/${file}`;
  const load = frogImages[key];
  if (!load) {
    throw new Error(`Frog image "${key}" not found in glob`);
  }
  return (await load()).default;
}

async function makeLqip(file: string): Promise<string> {
  const abs = path.join(process.cwd(), "src/assets/img/frogs", file);
  const buf = await readFile(abs);
  const out = await sharp(buf)
    .resize(24, null, { fit: "inside" })
    .webp({ quality: 40 })
    .toBuffer();
  return `data:image/webp;base64,${out.toString("base64")}`;
}

const family = await loadFrog(familyImage);
const familyLqip = await makeLqip(familyImage);
const items = await Promise.all(
  frogs.map(async (f) => ({
    ...f,
    meta: await loadFrog(f.file),
    lqip: await makeLqip(f.file),
  })),
);
---

<BaseLayout title="Dmitry Shabat — Frogs">
  <div class="page">
    <Nav items={navItems} />
    <section class="section" aria-labelledby="frogs-heading">
      <h2 id="frogs-heading" class="stuff-section-title">Frogs</h2>
      <figure class="frogs-banner">
        <div
          class="frogs-banner-img-wrap"
          style={`--lqip: url(${familyLqip})`}
        >
          <Image
            src={family}
            alt="The frog family"
            class="frogs-banner-img"
            loading="eager"
            data-fade
          />
        </div>
        <figcaption class="frogs-banner-caption">
          The family, as of 2026-05-17
        </figcaption>
      </figure>
      <h3 class="frogs-gallery-heading">Gallery - {frogs.length} as of now</h3>
      <div class="frogs-grid">
        {
          items.map((f) => (
            <figure class="frog-item">
              <div class="frog-img-wrap" style={`--lqip: url(${f.lqip})`}>
                <Image
                  src={f.meta}
                  alt={f.name}
                  class="frog-img"
                  loading="lazy"
                  data-fade
                />
              </div>
              <figcaption class="frog-caption">
                <span class="frog-name">{f.name}</span>
                {f.origin && <span class="frog-origin">{f.origin}</span>}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const mark = (img) => img.classList.add("loaded");
    const imgs = document.querySelectorAll("img[data-fade]");
    imgs.forEach((img) => {
      if (img.complete && img.naturalWidth > 0) mark(img);
      else img.addEventListener("load", () => mark(img), { once: true });
    });
  })();
</script>

<style>
  .section {
    margin-bottom: var(--space-xl);
  }

  .stuff-section-title {
    font-family: var(--font-family-heading);
    font-size: clamp(1.75rem, 4vw, 2.35rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 var(--space-md);
    text-align: center;
    color: var(--heading-color);
  }

  .frogs-banner {
    margin: 0 auto var(--space-lg);
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .frogs-banner-img-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    width: 100%;
    max-height: 60vh;
  }

  .frogs-banner-img-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--lqip);
    background-size: cover;
    background-position: center;
    filter: blur(14px);
    transform: scale(1.1);
    z-index: 0;
  }

  .frogs-banner-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    max-height: 60vh;
    object-fit: contain;
    display: block;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .frogs-banner-img.loaded {
    opacity: 1;
  }

  .frogs-banner-caption {
    margin-top: var(--space-xs);
    font-family: var(--font-family-base);
    font-size: 1rem;
    color: var(--text-muted-color);
  }

  .frogs-gallery-heading {
    margin: 0 0 var(--space-md);
    text-align: center;
    font-family: var(--font-family-heading);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--heading-color);
  }

  .frogs-grid {
    column-count: 3;
    column-gap: var(--space-md);
  }

  @media (max-width: 960px) {
    .frogs-grid {
      column-count: 2;
    }
  }

  @media (max-width: 520px) {
    .frogs-grid {
      column-count: 1;
    }
  }

  .frog-item {
    break-inside: avoid;
    margin: 0 0 var(--space-md);
    display: inline-block;
    width: 100%;
  }

  .frog-img-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
  }

  .frog-img-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--lqip);
    background-size: cover;
    background-position: center;
    filter: blur(14px);
    transform: scale(1.1);
    z-index: 0;
  }

  .frog-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    display: block;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .frog-img.loaded {
    opacity: 1;
  }

  .frog-caption {
    margin-top: var(--space-xs);
    text-align: center;
    font-family: var(--font-family-base);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .frog-name {
    font-size: 1rem;
    color: var(--text-color);
  }

  .frog-origin {
    font-size: 0.8rem;
    color: var(--text-muted-color);
  }
</style>
