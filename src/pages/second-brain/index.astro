---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SecondBrainApp from "../../components/SecondBrainApp";
---

<BaseLayout title="Second Brain">
  <SecondBrainApp baseUrl={import.meta.env.BASE_URL} client:only="react" />
</BaseLayout>

<style is:global>
  .second-brain-graph {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    will-change: transform;
  }
</style>

